set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
if(NOT DEFINED ORTTS_C_COMPILER)
  set(ORTTS_C_COMPILER aarch64-linux-gnu-gcc)
endif()
if(NOT DEFINED ORTTS_CXX_COMPILER)
  set(ORTTS_CXX_COMPILER aarch64-linux-gnu-g++)
endif()
set(CMAKE_C_COMPILER "${ORTTS_C_COMPILER}")
set(CMAKE_CXX_COMPILER "${ORTTS_CXX_COMPILER}")
if(DEFINED ORTTS_TARGET_SYSROOT AND NOT "${ORTTS_TARGET_SYSROOT}" STREQUAL "")
  set(CMAKE_SYSROOT "${ORTTS_TARGET_SYSROOT}")
  set(CMAKE_FIND_ROOT_PATH "${ORTTS_TARGET_SYSROOT}")
endif()
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
