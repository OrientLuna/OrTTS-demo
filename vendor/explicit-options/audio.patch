+namespace {
+void apply_p3_predictor_source(
+    Qwen3TTSAssets & assets,
+    const std::string & directory,
+    const std::string & expected_sha) {
+    const std::filesystem::path root(directory);
+    const auto config_json = json::parse_file(root / "config.json");
+    const auto p3 = parse_code_predictor_config(config_json);
+    const auto & original = assets.config.code_predictor;
+    if (p3.num_hidden_layers != 3 || p3.hidden_size != original.hidden_size ||
+        p3.intermediate_size != original.intermediate_size ||
+        p3.num_attention_heads != original.num_attention_heads ||
+        p3.num_key_value_heads != original.num_key_value_heads ||
+        p3.head_dim != original.head_dim || p3.vocab_size != 2048 ||
+        json::require_i64(config_json, "num_code_groups") != 16 ||
+        p3.rms_norm_eps != original.rms_norm_eps || p3.rope_theta != original.rope_theta)
+        throw std::invalid_argument("P3 source does not match own-base predictor interface");
+    if (std::filesystem::exists(root / "predictor.gguf") || assets.config.talker.hidden_size != 1024 || std::filesystem::exists(root / "talker_config.json")) {
+        const auto own = json::parse_file(root / "talker_config.json");
+        if (json::require_i64(own, "hidden_size") != assets.config.talker.hidden_size || json::require_i64(own, "vocab_size") != assets.config.talker.vocab_size)
+            throw std::runtime_error("P3 own Talker config mismatch");
+    }
+    if (std::filesystem::exists(root / "predictor.gguf")) {
+        if (expected_sha.size() != 64 || ortts_sha256::file((root / "predictor.gguf").string()) != expected_sha)
+            throw std::runtime_error("P3 native GGUF SHA binding mismatch");
+        auto native = engine::assets::open_tensor_source(root / "predictor.gguf");
+        const size_t count = assets.config.talker.hidden_size == original.hidden_size ? 64 : 66;
+        if (native->tensors().size() != count)
+            throw std::runtime_error("P3 native own-base tensor count mismatch");
+        assets.model_weights = std::make_shared<P3NativeSource>(assets.model_weights, native);
+        fprintf(stderr, "ORTTS_P3_STORAGE=native_GGUF NATIVE_TENSORS=%zu NO_FULL_F32_REPLACEMENT=1\n", count);
+    } else {
+        auto source = engine::assets::open_tensor_source(root / "predictor.safetensors");
+        const bool needs_projection = assets.config.talker.hidden_size != original.hidden_size;
+        if (source->tensors().size() != size_t(needs_projection ? 66 : 64))
+            throw std::invalid_argument("P3 requires complete own-base predictor including projection");
+        engine::assets::WeightAdapter replacement;
+        for (const auto & tensor : source->tensors()) {
+            if (tensor.name.rfind("model.", 0) != 0 && tensor.name.rfind("lm_head.", 0) != 0 && !(needs_projection && (tensor.name == "small_to_mtp_projection.weight" || tensor.name == "small_to_mtp_projection.bias")))
+                throw std::invalid_argument("Unexpected P3 tensor: " + tensor.name);
+            auto data = source->require_f32_tensor(tensor.name);
+            replacement.replacements.emplace("talker.code_predictor." + tensor.name,
+                engine::assets::WeightReplacement{tensor.shape, std::move(data.values)});
+        }
+        assets.model_weights = engine::assets::make_weight_adapter_source(
+            assets.model_weights, std::move(replacement), "qwen3_tts.p3_complete_source");
+        fprintf(stderr, "ORTTS_P3_STORAGE=F32_overlay\n");
+    }
+    assets.config.code_predictor = p3;
+}
+}  // namespace
+
+std::shared_ptr<const Qwen3TTSAssets> apply_qwen3_tts_p3(
+    std::shared_ptr<const Qwen3TTSAssets> assets,
+    const std::unordered_map<std::string, std::string> & options) {
+    const auto source = options.find("qwen3_tts.p3_predictor_source");
+    if (source == options.end() || source->second.empty()) {
+        return assets;
+    }
+    const auto sha = options.find("qwen3_tts.p3_native_sha256");
+    auto updated = std::make_shared<Qwen3TTSAssets>(*assets);
+    apply_p3_predictor_source(*updated, source->second, sha != options.end() ? sha->second : std::string{});
+    return updated;
+}
