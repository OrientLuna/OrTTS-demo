+++ b/src/framework/core/android_cpu_features.h
@@ -0,0 +1,17 @@
+#pragma once
+#include <cstdint>
+
+namespace engine::core {
+// Linux AArch64 HWCAP ABI: ASIMD, FPHP, ASIMDHP, ASIMDDP; HWCAP2 I8MM.
+inline bool android_cpu_supported(int variant, uint64_t hwcap, uint64_t hwcap2) {
+    constexpr uint64_t asimd = 1ULL << 1;
+    constexpr uint64_t fp16 = (1ULL << 9) | (1ULL << 10);
+    constexpr uint64_t dotprod = 1ULL << 20;
+    constexpr uint64_t i8mm = 1ULL << 13;
+    if (!(hwcap & asimd)) return false;
+    if (variant == 0) return true;
+    const auto required = asimd | fp16 | dotprod;
+    if ((hwcap & required) != required) return false;
+    return variant == 1 || (variant == 2 && (hwcap2 & i8mm));
+}
