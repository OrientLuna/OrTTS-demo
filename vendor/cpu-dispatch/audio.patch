+#endif
+inline ggml_status ortts_graph_compute(ggml_context * c, ggml_cgraph * g, int threads) {
+#ifdef ORTTS_ANDROID_CPU_AUTO
+    engine::core::ensure_backends_loaded();
+    auto dev = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU);
+    if (!dev) throw std::runtime_error("CPU registry missing");
+    auto reg = ggml_backend_dev_backend_reg(dev);
+    auto compute = reinterpret_cast<decltype(&ggml_graph_compute_with_ctx)>(ggml_backend_reg_get_proc_address(reg, "ggml_graph_compute_with_ctx"));
+    if (!compute) throw std::runtime_error("Selected CPU graph compute API missing");
+    return compute(c, g, threads);
+#else
+    return ggml_graph_compute_with_ctx(c, g, threads);
+#endif
+}
