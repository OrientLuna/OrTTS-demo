@@ -0,0 +1,67 @@
+#pragma once
+#include "engine/framework/debug/trace.h"
+#include "android_cpu_features.h"
+#include <android/log.h>
+#include <dlfcn.h>
+#include <sys/auxv.h>
+#include <cstdlib>
+#include <mutex>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace engine::core {
+inline void ensure_android_cpu_module() {
+    static std::once_flag once;
+    static std::string selected, reason;
+    std::call_once(once, [] {
+        Dl_info info{};
+        if (!dladdr(reinterpret_cast<void *>(&ensure_android_cpu_module), &info) || !info.dli_fname)
+            throw std::runtime_error("CPU dispatch cannot resolve its library directory");
+        std::string library(info.dli_fname);
+        auto slash = library.rfind('/');
+        if (slash == std::string::npos || library.front() != '/')
+            throw std::runtime_error("CPU dispatch requires an absolute library path");
+        const auto directory = library.substr(0, slash + 1);
+        const auto hwcap = getauxval(AT_HWCAP), hwcap2 = getauxval(AT_HWCAP2);
+        std::vector<std::string> names{"android_armv8.6_1", "android_armv8.2_2", "android_armv8.0_1"};
+        auto variant = [](const std::string & name) { return name == "android_armv8.6_1" ? 2 : name == "android_armv8.2_2" ? 1 : 0; };
+#if ORTTS_CPU_DISPATCH_QA
+        if (const char * value = std::getenv("ORTTS_QA_CPU_MODULE")) {
+            std::string forced(value);
+            bool known = forced == names[0] || forced == names[1] || forced == names[2];
+            if (!known || !android_cpu_supported(variant(forced), hwcap, hwcap2)) {
+                reason = "override_rejected:" + forced + ";baseline_fallback;";
+                forced = "android_armv8.0_1";
+            } else reason = "qa_override;";
+            names = {forced};
+        }
+#endif
+        for (const auto & name : names) {
+            if (!android_cpu_supported(variant(name), hwcap, hwcap2)) {
+                reason += name + ":hwcap_filtered_before_dlopen;";
+                continue;
+            }
+            // Official load owns its handle and validates score/API before registration.
+            const auto path = directory + "libggml-cpu-" + name + ".so";
+            auto reg = ggml_backend_load(path.c_str());
+            if (!reg) { reason += name + ":load_failed;"; continue; }
+            bool valid = true;
+            for (const char * symbol : {"ggml_threadpool_new", "ggml_threadpool_free", "ggml_backend_cpu_set_threadpool", "ggml_graph_compute_with_ctx"})
+                if (!ggml_backend_reg_get_proc_address(reg, symbol)) valid = false;
+            if (!valid) {
+                ggml_backend_unload(reg);
+                reason += name + ":required_API_missing;";
+                continue;
+            }
+            selected = name;
+            break;
+        }
+        if (selected.empty()) throw std::runtime_error("No supported CPU module: " + reason);
+        if (reason.empty()) reason = "auto_priority_supported_official_score";
+        __android_log_print(ANDROID_LOG_INFO, "OrTTSCPU", "selected=%s registry=CPU reason=%s directory=%s", selected.c_str(), reason.c_str(), directory.c_str());
+    });
+    debug::trace_log_scalar("ortts.cpu_dispatch.selected", std::string_view(selected));
+    debug::trace_log_scalar("ortts.cpu_dispatch.reason", std::string_view(reason));
+}
