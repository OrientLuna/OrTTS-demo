+ std::vector<float> require_f32(std::string_view n,const std::optional<std::vector<int64_t>>&shape)const override{return pred(n)?native_->require_f32(local(n),shape):base_->require_f32(n,shape);}
+ std::optional<std::vector<float>> optional_f32(std::string_view n,const std::optional<std::vector<int64_t>>&shape)const override{if(!has_tensor(n))return std::nullopt;return require_f32(n,shape);}
+ void set_backend_tensor(ggml_tensor*t,std::string_view n,Storage s,const std::vector<int64_t>&shape)const override{if(pred(n))native_->set_backend_tensor(t,local(n),s,shape);else base_->set_backend_tensor(t,n,s,shape);}
