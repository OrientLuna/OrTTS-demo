+ }
+ const std::filesystem::path& source_path()const noexcept override{return base_->source_path();}
+ bool has_tensor(std::string_view n)const noexcept override{return pred(n)?native_->has_tensor(local(n)):base_->has_tensor(n);}
+ Meta require_metadata(std::string_view n)const override{if(!pred(n))return base_->require_metadata(n);auto m=native_->require_metadata(local(n));m.name=std::string(n);return m;}
