+std::vector<float> Lfm2DetokenizerRuntime::stream_embeddings(const std::vector<float> & embeddings) {
+    if (impl_->embedding_stream == nullptr)
+        throw std::runtime_error("LFM2 embedding stream has not been started");
+    const auto & config = impl_->config;
+    const auto d = static_cast<size_t>(config.lfm.hidden_size);
+    if (d == 0 || embeddings.size() % d != 0 ||
+        !std::all_of(embeddings.begin(), embeddings.end(), [](float v) { return std::isfinite(v); }))
+        throw std::invalid_argument("LFM2 embedding stream shape/nonfinite input");
+    std::vector<float> out;
+    out.reserve(embeddings.size() / d * config.upsample * config.output_size);
+    for (size_t offset = 0; offset < embeddings.size(); offset += d) {
+        const auto values = impl_->embedding_stream->run_embeddings(embeddings.data() + offset);
+        out.insert(out.end(), values.begin(), values.end());
+    }
+    return out;
+}
