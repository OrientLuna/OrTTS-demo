+// Decode a real captured codes file with the native ggml decoder and write the
+// PCM plus optional per-stage activations. Diagnosis tool for the codec QNN
+// export; not part of model behaviour.
+#include "engine/models/qwen3_tts/assets.h"
+#include "engine/models/qwen3_tts/tokenizer_speech_decoder.h"
+
+#include <cstdint>
+#include <cstdio>
+#include <fstream>
+#include <iostream>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+int main(int argc, char ** argv) {
+    std::string model, codes_path, out_path;
+    for (int i = 1; i < argc; ++i) {
+        const std::string arg(argv[i]);
+        if (arg == "--model" && i + 1 < argc) model = argv[++i];
+        else if (arg == "--codes" && i + 1 < argc) codes_path = argv[++i];
+        else if (arg == "--out" && i + 1 < argc) out_path = argv[++i];
+        else throw std::runtime_error("usage: --model GGUF --codes codes.i32 --out pcm.f32");
+    }
+    if (model.empty() || codes_path.empty() || out_path.empty())
+        throw std::runtime_error("usage: --model GGUF --codes codes.i32 --out pcm.f32");
+    namespace qwen = engine::models::qwen3_tts;
+    auto assets = qwen::load_qwen3_tts_assets(model);
+    engine::core::BackendConfig backend;
+    backend.threads = 8;
+    backend.type = engine::core::BackendType::Cpu;
+    engine::core::ExecutionContext execution(backend);
+    qwen::Qwen3SpeechTokenizerDecoderRuntime decoder(
+        assets, execution, 256ull << 20, 1536ull << 20,
+        engine::assets::TensorStorageType::F32, engine::assets::TensorStorageType::F32,
+        qwen::Qwen3TTSPerfMode::Standard);
+    std::ifstream input(codes_path, std::ios::binary);
+    if (!input) throw std::runtime_error("codes open failed");
+    std::vector<int32_t> codes;
+    int32_t value = 0;
+    while (input.read(reinterpret_cast<char *>(&value), sizeof(value))) codes.push_back(value);
+    if (codes.empty() || codes.size() % 16 != 0) throw std::runtime_error("codes must be frames x 16");
+    qwen::Qwen3SpeechCodes payload;
+    payload.frames = static_cast<int64_t>(codes.size() / 16);
+    payload.code_groups = 16;
+    payload.codes = std::move(codes);
+    const auto audio = decoder.decode(payload);
+    std::ofstream output(out_path, std::ios::binary);
+    if (!output) throw std::runtime_error("out open failed");
+    output.write(reinterpret_cast<const char *>(audio.samples.data()),
+                 static_cast<std::streamsize>(audio.samples.size() * sizeof(float)));
+    std::cout << "decoded " << audio.samples.size() << " samples from " << payload.frames << " frames\n";
+    return 0;
+}
