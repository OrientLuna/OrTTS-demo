+std::vector<float> Lfm2DetokenizerRuntime::decode_embeddings(const std::vector<float> & embeddings) {
+    const auto & config = impl_->config;
+    const auto values = spectrum_embeddings(embeddings);
+    const int64_t frames = static_cast<int64_t>(embeddings.size() / config.lfm.hidden_size);
+    auto pcm = lfm2_audio_istft(values, frames * config.upsample, impl_->weights.window, config.hop_length);
+    if (pcm.size() != static_cast<size_t>(frames * config.upsample * config.hop_length) ||
+        !std::all_of(pcm.begin(), pcm.end(), [](float v) { return std::isfinite(v); }))
+        throw std::runtime_error("LFM2 embedding PCM invalid length/nonfinite");
+    return pcm;
+}
