diff --git a/src/framework/modules/ortts_tconv_raw_gemm.h b/src/framework/modules/ortts_tconv_raw_gemm.h
new file mode 100644
index 0000000..53a9328
--- /dev/null
+++ b/src/framework/modules/ortts_tconv_raw_gemm.h
@@ -0,0 +1,41 @@
+// Adapted from speech.cpp CodecGraph::tconv, MIT, Copyright (c) 2026 Sakasegawa.
+// Commit d074e1b9d84fe5ec530c959292ffe3d94ffd288b. See sibling ortts_tconv_LICENSE.MIT in the deployment tree.
+// General ConvTranspose1d RAW result: no causal crop and no persistent stream state.
+#pragma once
+#include "ggml.h"
+#include <stdexcept>
+namespace ortts_codec_gemm {
+// Optional packed weights are ggml [Cin,Cout,K], same dtype as native weights.
+// The caller may cache this pack with its model constants; no global pointer cache.
+inline ggml_tensor * raw_tconv_gemm(ggml_context *ctx, ggml_tensor *x,
+        ggml_tensor *w, int stride, ggml_tensor *packed=nullptr) {
+    if(!ctx || !x || !w || stride<=0 || x->ne[2]!=1 || x->ne[3]!=1 ||
+       w->ne[3]!=1 || x->ne[0]<=0 || x->ne[1]!=w->ne[2] ||
+       (w->ne[0]!=stride && w->ne[0]!=2*stride) || x->type!=GGML_TYPE_F32 ||
+       (w->type!=GGML_TYPE_F32 && w->type!=GGML_TYPE_F16) ||
+       !ggml_is_contiguous(x) || !ggml_is_contiguous(w))
+        throw std::invalid_argument("raw tconv: require native contiguous F32 x and F32/F16 w, K=s/2s");
+    const int64_t t=x->ne[0],ci=w->ne[2],co=w->ne[1],k=w->ne[0];
+    if(packed && (packed->type!=w->type || packed->ne[0]!=ci || packed->ne[1]!=co ||
+       packed->ne[2]!=k || packed->ne[3]!=1 || !ggml_is_contiguous(packed)))
+        throw std::invalid_argument("raw tconv: bad caller-owned packed weight");
+    auto *wp=packed ? packed : ggml_cont(ctx,ggml_permute(ctx,w,2,1,0,3));
+    auto *wm=ggml_reshape_2d(ctx,wp,ci,co*k);
+    auto *xc=ggml_cont(ctx,ggml_transpose(ctx,x));
+    // Match native CPU F16 tconv's activation rounding explicitly, independent
+    // of which GEMM kernel is selected. F32 weights retain F32 activations.
+    if(w->type==GGML_TYPE_F16) xc=ggml_cast(ctx,ggml_cast(ctx,xc,GGML_TYPE_F16),GGML_TYPE_F32);
+    auto *a=ggml_mul_mat(ctx,ggml_view_2d(ctx,wm,ci,co*stride,wm->nb[1],0),xc);
+    ggml_mul_mat_set_prec(a,GGML_PREC_F32);
+    if(k==2*stride) {
+        auto *b=ggml_mul_mat(ctx,ggml_view_2d(ctx,wm,ci,co*stride,wm->nb[1],co*stride*wm->nb[1]),xc);
+        ggml_mul_mat_set_prec(b,GGML_PREC_F32);
+        // [co*s,T+1]: zero on the right of A; zero on the left of B.
+        // Last column is the full raw tail, NOT cropped or bias-free stream state.
+        a=ggml_add(ctx,ggml_pad_ext(ctx,a,0,0,0,1,0,0,0,0),
+                       ggml_pad_ext(ctx,b,0,0,1,0,0,0,0,0));
+    }
+    auto *cf=ggml_reshape_2d(ctx,a,co,(t-1)*stride+k);
+    return ggml_cont(ctx,ggml_transpose(ctx,cf)); // native [raw_frames,Cout]
+}
+}
