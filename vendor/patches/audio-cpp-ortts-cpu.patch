diff --git a/include/engine/models/qwen3_tts/cpu_codec_worker.h b/include/engine/models/qwen3_tts/cpu_codec_worker.h
new file mode 100644
index 0000000..42c3587
--- /dev/null
+++ b/include/engine/models/qwen3_tts/cpu_codec_worker.h
@@ -0,0 +1,157 @@
+#pragma once
+
+// Qwen session-local transport only. Decoder/controller callbacks have one owner.
+#include <algorithm>
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <deque>
+#include <exception>
+#include <functional>
+#include <future>
+#include <mutex>
+#include <stdexcept>
+#include <thread>
+#include <utility>
+#include <vector>
+
+namespace engine::models::qwen3_tts {
+
+inline void validate_cpu_codec_options(bool enabled, bool chunked, bool offline,
+                                       bool cpu, int talker_threads, int decoder_threads) {
+    if (!(enabled || chunked)) return;
+    if (!cpu || !offline) throw std::invalid_argument("CPU codec chunks require explicit CPU/offline mode");
+    if (talker_threads < 1 || talker_threads > 4 || decoder_threads < 1 || decoder_threads > 4)
+        throw std::invalid_argument("CPU codec thread counts must be in 1..4");
+    if (enabled && talker_threads + decoder_threads > 4)
+        throw std::invalid_argument("CPU codec pipeline requires talker_threads + decoder_threads <= 4");
+}
+
+template<class Result>
+class CpuCodecWorker {
+public:
+    using Frame = std::vector<int32_t>;
+    struct Metrics { size_t queued_peak = 0; size_t blocked_pushes = 0; double producer_wait_ms = 0; };
+
+    CpuCodecWorker(size_t capacity_frames, size_t frame_width,
+                   std::function<void()> begin,
+                   std::function<void(const Frame &)> consume,
+                   std::function<Result()> finish,
+                   std::function<void()> cleanup)
+        : capacity_(capacity_frames), width_(frame_width), begin_(std::move(begin)),
+          consume_(std::move(consume)), finish_(std::move(finish)), cleanup_(std::move(cleanup)),
+          result_(promise_.get_future()) {
+        if (!capacity_ || !width_ || !begin_ || !consume_ || !finish_ || !cleanup_)
+            throw std::invalid_argument("invalid Qwen codec worker configuration");
+        worker_ = std::thread([this] { run(); });
+    }
+    CpuCodecWorker(const CpuCodecWorker &) = delete;
+    CpuCodecWorker & operator=(const CpuCodecWorker &) = delete;
+    ~CpuCodecWorker() { abort(); }
+
+    // Own the frame before enqueue; never retain a Talker/controller borrowed view.
+    void push(Frame frame) {
+        if (frame.size() != width_) throw std::invalid_argument("codec FIFO requires one complete frame");
+        std::unique_lock<std::mutex> lock(mutex_);
+        if (queue_.size() == capacity_ && !closed_ && !cancelled_ && !error_) {
+            ++metrics_.blocked_pushes;
+            const auto start = Clock::now();
+            space_.wait(lock, [this] { return queue_.size() < capacity_ || closed_ || cancelled_ || error_; });
+            metrics_.producer_wait_ms += std::chrono::duration<double, std::milli>(Clock::now() - start).count();
+        }
+        if (error_) std::rethrow_exception(error_);
+        if (closed_ || cancelled_) throw std::runtime_error("codec FIFO closed/aborted");
+        queue_.push_back(std::move(frame));
+        metrics_.queued_peak = std::max(metrics_.queued_peak, queue_.size());
+        lock.unlock();
+        data_.notify_one();
+    }
+
+    // EOF drains all queued frames, then calls finish exactly once; not codec EOS data.
+    Result finish() {
+        {
+            std::lock_guard<std::mutex> lock(mutex_);
+            if (joined_) throw std::logic_error("codec worker finish called twice");
+            closed_ = true;
+        }
+        data_.notify_all();
+        space_.notify_all();
+        worker_.join();
+        joined_ = true;
+        return result_.get();
+    }
+
+    // Cooperative abort cannot preempt a running GGML kernel; join waits for it.
+    // Lifecycle methods are called by the owning generation thread only.
+    void abort() noexcept {
+        if (!worker_.joinable()) return;
+        {
+            std::lock_guard<std::mutex> lock(mutex_);
+            cancelled_ = closed_ = true;
+            queue_.clear();
+        }
+        data_.notify_all();
+        space_.notify_all();
+        worker_.join();
+        joined_ = true;
+    }
+    Metrics metrics() const {
+        std::lock_guard<std::mutex> lock(mutex_);
+        return metrics_;
+    }
+
+private:
+    using Clock = std::chrono::steady_clock;
+    void run() noexcept {
+        try {
+            begin_();
+            for (;;) {
+                Frame frame;
+                {
+                    std::unique_lock<std::mutex> lock(mutex_);
+                    data_.wait(lock, [this] { return cancelled_ || closed_ || !queue_.empty(); });
+                    if (cancelled_) throw std::runtime_error("codec worker aborted");
+                    if (queue_.empty()) break;
+                    frame = std::move(queue_.front());
+                    queue_.pop_front();
+                }
+                space_.notify_one();
+                consume_(frame);
+            }
+            auto output = finish_();
+            {
+                std::lock_guard<std::mutex> lock(mutex_);
+                if (cancelled_) throw std::runtime_error("codec worker aborted during finish");
+            }
+            promise_.set_value(std::move(output));
+        } catch (...) {
+            const auto failure = std::current_exception();
+            // Release blocked producers before potentially expensive decoder cleanup.
+            {
+                std::lock_guard<std::mutex> lock(mutex_);
+                error_ = failure;
+                cancelled_ = closed_ = true;
+                queue_.clear();
+            }
+            data_.notify_all();
+            space_.notify_all();
+            try { cleanup_(); } catch (...) {} // preserve the first failure
+            promise_.set_exception(failure);
+        }
+    }
+    const size_t capacity_, width_;
+    std::function<void()> begin_;
+    std::function<void(const Frame &)> consume_;
+    std::function<Result()> finish_;
+    std::function<void()> cleanup_;
+    mutable std::mutex mutex_;
+    std::condition_variable data_, space_;
+    std::deque<Frame> queue_;
+    bool closed_ = false, cancelled_ = false, joined_ = false;
+    std::exception_ptr error_;
+    Metrics metrics_;
+    std::promise<Result> promise_;
+    std::future<Result> result_;
+    std::thread worker_;
+};
+} // namespace engine::models::qwen3_tts
