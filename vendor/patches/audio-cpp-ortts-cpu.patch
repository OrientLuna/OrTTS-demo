+Qwen3TalkerPrefill fixed_voice_prefill(const Qwen3TextTokenizer & tokenizer,
+    const Qwen3TTSRequest & request, const Qwen3VoiceClonePrompt & prompt,
+    int64_t limit) {
+    if (prompt.icl_mode || prompt.reference_codes || !prompt.reference_text_ids.empty())
+        throw std::invalid_argument("fixed voice forbids ICL/reference codes");
+    Qwen3TalkerPrefill p;
+    p.prompt_mode = Qwen3TalkerPromptMode::VoiceClone;
+    p.input_ids = tokenizer.encode(tokenizer.build_assistant_prompt(request.text));
+    if (limit <= 0 || p.input_ids.size() > static_cast<size_t>(limit))
+        throw std::invalid_argument("fixed voice text token limit exceeded");
+    p.speaker_embedding = prompt.speaker_embedding;
+    p.language = request.language;
+    p.icl_mode = false;
+    p.x_vector_only_mode = true;
+    return p;
+}
