+++ b/src/models/qwen3_tts/ortts_joint/private_adapter.cpp
@@ -0,0 +1,92 @@
+#include "private_adapter.h"
+#include "binding_checks.h"
+#include "bridge_graph.h"
+#include "../../../community_models/lfm2_audio/assets.cpp"
+#include "engine/community_models/lfm2_audio/detokenizer.h"
+#include "engine/framework/io/json.h"
+#include "ggml-cpu.h"
+#include <map>
+#include <fstream>
+#include <chrono>
+#include <filesystem>
+#include <cmath>
+#include <cstring>
+#include <cstdio>
+namespace ortts_b0 {
+namespace q=engine::community_models::lfm2_audio;namespace b=ortts_lfm_bridge;
+using Clock=std::chrono::steady_clock;
+static double ms(Clock::time_point s){return std::chrono::duration<double,std::milli>(Clock::now()-s).count();}
+struct Ctx {ggml_context*c;explicit Ctx(size_t n):c(ggml_init({n,nullptr,false})){if(!c)throw std::runtime_error("ggml alloc");}~Ctx(){ggml_free(c);}};
+struct Adapter::Impl {
+Ctx weights{48ull<<20};std::map<std::string,ggml_tensor*>ts;b::BridgeWeights bw{};b::DequantWeights dw{};
+ std::shared_ptr<const engine::assets::TensorSource>dt,vc;
+ engine::core::ExecutionContext execution;
+  std::unique_ptr<q::Lfm2DetokenizerRuntime> runtime;
+  std::unique_ptr<q::Lfm2StreamingIstft> stream_istft;
+  std::vector<int32_t> bridge_history;
+  std::vector<float> stream_embeddings_history;
+ int threads;
+ static engine::core::BackendConfig backend(int threads){engine::core::BackendConfig bc;bc.type=engine::core::BackendType::Cpu;bc.threads=threads;const char*target=std::getenv("ORTTS_PRIVATE_FAST_BACKEND");if(target&&std::string(target)=="cuda") {bc.type=engine::core::BackendType::Cuda;bc.device=0;}return bc;}
+ Impl(const std::string&bundle,const std::string&detok,const std::string&voc,const std::string&base,const std::string&trusted_manifest,int requested_threads):execution(backend(requested_threads)),threads(requested_threads){
+  if(threads<1||threads>8)throw std::invalid_argument("joint decoder threads outside 1..8");
+  fprintf(stderr,"ORTTS_JOINT_FAST_BACKEND=%s DEQUANT=CPU%d BRIDGE=CPU%d\n",ggml_backend_name(execution.backend()),threads,threads);
+ auto m=engine::io::json::parse_file(std::filesystem::path(bundle)/"MANIFEST.json");
+ tail_binding::validate(m,bundle,detok,voc,base,trusted_manifest);
+ if(m.require("endianness").as_string()!="little")throw std::runtime_error("endianness");
+ const auto&items=m.require("tensors").as_object();if(items.size()!=28)throw std::runtime_error("bundle tensors count");
+ for(const auto&kv:items){auto&s=kv.second;tail_binding::match(std::filesystem::path(bundle)/s.require("path").as_string(),s.require("sha256").as_string());auto&shape=s.require("shape").as_array();int64_t dims[4]={1,1,1,1};if(shape.empty()||shape.size()>3||s.require("dtype").as_string()!="F32")throw std::runtime_error("tensor schema");for(size_t i=0;i<shape.size();i++)dims[i]=shape[shape.size()-1-i].as_i64();auto*t=ggml_new_tensor(weights.c,GGML_TYPE_F32,shape.size(),dims);auto n=ggml_nbytes(t);if(n!=size_t(s.require("bytes").as_i64()))throw std::runtime_error("tensor size");std::ifstream f(std::filesystem::path(bundle)/s.require("path").as_string(),std::ios::binary|std::ios::ate);if(!f||f.tellg()!=std::streamoff(n))throw std::runtime_error("raw size");f.seekg(0);f.read((char*)t->data,n);if(!f)throw std::runtime_error("raw read");for(int64_t j=0;j<ggml_nelements(t);j++){float v=((float*)t->data)[j];if(!std::isfinite(v)||((kv.first=="zstd"||kv.first=="hstd")&&v<=0))throw std::runtime_error("tensor finite/std");}ts[kv.first]=t;}
+ auto at=[&](const char*n){return ts.at(n);};bw={at("zmean"),at("zstd"),at("hmean"),at("hstd"),at("ridge.weight"),at("ridge.bias"),at("context.weight"),at("context.bias"),at("up.weight"),at("up.bias")};for(int k=0;k<16;k++)dw.normalized_tables[k]=ts.at("codebook."+std::to_string(k));dw.semantic_projection=at("semantic.projection.weight");dw.acoustic_projection=at("acoustic.projection.weight");
+  dt=engine::assets::open_tensor_source(detok);vc=engine::assets::open_tensor_source(voc);q::GgufMetadata meta(detok);auto cfg=q::read_detokenizer_config(meta,*dt,*vc,8);if(cfg.lfm.hidden_size!=512||cfg.lfm.num_layers()!=8||cfg.upsample*cfg.hop_length!=1920)throw std::runtime_error("LFM contract");runtime=std::make_unique<q::Lfm2DetokenizerRuntime>(dt,vc,cfg,execution,128,std::getenv("ORTTS_B0_DISABLE_REPACK")==nullptr);
+}
+ std::vector<float>compute(ggml_context*c,ggml_tensor*y)const{auto*g=ggml_new_graph_custom(c,2048,false);ggml_build_forward_expand(g,y);if(ggml_graph_compute_with_ctx(c,g,threads)!=GGML_STATUS_SUCCESS)throw std::runtime_error("bridge compute");auto*p=(float*)y->data;return {p,p+ggml_nelements(y)};}
+ Result decode(const std::vector<int32_t>&codes,int64_t frames,bool features_only=false){
+ if(frames<1||frames>4096||codes.size()!=size_t(frames*16))throw std::runtime_error("codes shape");for(auto c:codes)if(c<0||c>=2048)throw std::runtime_error("codes domain");auto begin=Clock::now();Result r;
+ {Ctx graph(64ull<<20);std::array<ggml_tensor*,16>c;for(int k=0;k<16;k++){c[k]=ggml_new_tensor_1d(graph.c,GGML_TYPE_I32,frames);for(int64_t t=0;t<frames;t++)((int32_t*)c[k]->data)[t]=codes[t*16+k];}
+  if(const char*p=std::getenv("ORTTS_B0_DUMP_SEM")){auto s=compute(graph.c,b::affine(graph.c,dw.semantic_projection,ggml_get_rows(graph.c,dw.normalized_tables[0],c[0]),dw.semantic_bias));std::ofstream f(p,std::ios::binary);f.write((char*)s.data(),s.size()*4);}
+  if(const char*p=std::getenv("ORTTS_B0_DUMP_ACS")){auto*a=ggml_get_rows(graph.c,dw.normalized_tables[1],c[1]);for(int k=2;k<16;k++)a=ggml_add(graph.c,a,ggml_get_rows(graph.c,dw.normalized_tables[k],c[k]));auto v=compute(graph.c,b::affine(graph.c,dw.acoustic_projection,a,dw.acoustic_bias));std::ofstream f(p,std::ios::binary);f.write((char*)v.data(),v.size()*4);}
+  r.z=compute(graph.c,b::dequant(graph.c,c,dw));}r.dequant_ms=ms(begin);
+ auto start=Clock::now();{Ctx graph(64ull<<20);auto*z=ggml_new_tensor_2d(graph.c,GGML_TYPE_F32,512,frames);memcpy(z->data,r.z.data(),r.z.size()*4);r.h=compute(graph.c,b::bridge(graph.c,z,bw));}r.bridge_ms=ms(start);
+  for(float x:r.h)if(!std::isfinite(x))throw std::runtime_error("bridge nonfinite");
+  if(features_only){r.total_ms=ms(begin);return r;}
+  start=Clock::now();r.pcm=runtime->decode_embeddings(r.h);r.decode_ms=ms(start);r.total_ms=ms(begin);if(r.pcm.size()!=size_t(frames*1920))throw std::runtime_error("PCM endpoint");return r;
+ }
+ void start_stream(){
+  runtime->start_embedding_stream();
+  bridge_history.clear();
+  stream_embeddings_history.clear();
+  stream_istft=std::make_unique<q::Lfm2StreamingIstft>(runtime->window(),runtime->config().hop_length);
+ }
+ Result stream(const std::vector<int32_t>&codes,int64_t frames){
+  if(!stream_istft)throw std::runtime_error("joint stream not started");
+  if(frames<1||frames>4094||codes.size()!=size_t(frames*16))throw std::runtime_error("stream codes shape");
+  const auto begin=Clock::now();
+  auto context=bridge_history;context.insert(context.end(),codes.begin(),codes.end());
+  auto r=decode(context,static_cast<int64_t>(context.size()/16),true);
+  // The bridge is causal with two preceding code frames. Keep only new rows.
+  const size_t prefix=(context.size()/16-size_t(frames))*512;
+  r.z.erase(r.z.begin(),r.z.begin()+prefix);
+  r.h.erase(r.h.begin(),r.h.begin()+prefix);
+  const auto start=Clock::now();
+  std::vector<float> spectrum;
+  if(std::getenv("ORTTS_B0_STREAM_PREFIX_REFERENCE")){
+   const auto first=static_cast<int64_t>(stream_embeddings_history.size()/512);
+   stream_embeddings_history.insert(stream_embeddings_history.end(),r.h.begin(),r.h.end());
+   spectrum=runtime->spectrum_embeddings(stream_embeddings_history,first);
+  }else spectrum=runtime->stream_embeddings(r.h);
+  r.pcm=stream_istft->push(spectrum,frames*runtime->config().upsample);
+  r.decode_ms=ms(start);r.total_ms=ms(begin);
+  const size_t keep=std::min(context.size(),size_t(32));
+  bridge_history.assign(context.end()-keep,context.end());
+  return r;
+ }
+ std::vector<float> finish_stream(){
+  if(!stream_istft)throw std::runtime_error("joint stream not started");
+  auto pcm=stream_istft->finish();stream_istft.reset();bridge_history.clear();return pcm;
+ }
+};
+Adapter::Adapter(const std::string&b,const std::string&d,const std::string&v,const std::string&base,const std::string&manifest,int threads):p(std::make_shared<Impl>(b,d,v,base,manifest,threads)){}
+Result Adapter::decode(const std::vector<int32_t>&c,int64_t n){return p->decode(c,n);}
+void Adapter::start_stream(){p->start_stream();}
+Result Adapter::stream(const std::vector<int32_t>&c,int64_t n){return p->stream(c,n);}
+std::vector<float> Adapter::finish_stream(){return p->finish_stream();}
+}
