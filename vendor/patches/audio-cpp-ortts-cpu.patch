+CpuCodecSettings cpu_codec_settings(const runtime::SessionOptions & options) {
+    CpuCodecSettings out;
+    if (const auto flag = runtime::find_option(options.options, {"qwen3_tts.codec_pipeline"}))
+        out.pipeline = runtime::parse_bool_option(*flag, "qwen3_tts.codec_pipeline");
+    out.chunk_frames = runtime::parse_int_option(options.options, {"qwen3_tts.cpu_chunk_frames"})
+        .value_or(out.pipeline ? 12 : 0);
+    out.queue_frames = runtime::parse_int_option(options.options, {"qwen3_tts.codec_queue_frames"}).value_or(24);
+    const auto talker = runtime::parse_int_option(options.options, {"qwen3_tts.talker_threads"});
+    const auto decoder = runtime::parse_int_option(options.options, {"qwen3_tts.decoder_threads"});
+    out.talker_threads = talker.value_or(std::max(1, options.backend.threads));
+    out.decoder_threads = decoder.value_or(std::max(1, options.backend.threads));
+    if (out.chunk_frames < 0 || out.chunk_frames > 256 || (out.pipeline && out.chunk_frames == 0) ||
+        out.queue_frames < 1 || out.queue_frames > 4096)
+        throw std::invalid_argument("invalid Qwen CPU chunk/FIFO bound");
+    validate_cpu_codec_options(out.pipeline, out.chunk_frames > 0 || talker || decoder,
+                               true, options.backend.type == core::BackendType::Cpu,
+                               out.talker_threads, out.decoder_threads);
+    return out;
+}
