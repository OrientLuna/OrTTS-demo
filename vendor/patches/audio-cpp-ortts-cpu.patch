+// KV lifetime is independent of graph shape. Attention-only bucket changes
+// borrow these buffers instead of reallocating or migrating live history.
+class TalkerKVBacking {
+public:
+    struct BufferDeleter { void operator()(ggml_backend_buffer_t p) const { ggml_backend_buffer_free(p); } };
+    std::shared_ptr<const Qwen3TalkerWeightsRuntime> weights;
+    std::unique_ptr<ggml_context, GgmlContextDeleter> ctx;
+    std::unique_ptr<ggml_backend_buffer, BufferDeleter> buffer;
+    runtime::TransformerKVCache cache;
+    TalkerKVBacking(std::shared_ptr<const Qwen3TalkerWeightsRuntime> w, int64_t capacity):weights(std::move(w)) {
+        const auto alignment=weights->talker_kv_cache_alignment();
+        capacity+=(alignment-capacity%alignment)%alignment;
+        ctx.reset(ggml_init({1u<<20,nullptr,true}));
+        if(!ctx)throw std::runtime_error("Talker shared KV metadata allocation failed");
+        const auto & config=weights->assets().config.talker;
+        core::ModuleBuildContext build{ctx.get(),"qwen3_tts.talker.shared_kv"};
+        std::vector<core::TensorValue> keys,values;
+        for(int64_t i=0;i<config.num_hidden_layers;++i){
+            const auto shape=core::TensorShape::from_dims({1,capacity,config.num_key_value_heads,attention_head_dim(config)});
+            keys.push_back(core::make_tensor(build,weights->kv_cache_type(),shape));
+            values.push_back(core::make_tensor(build,weights->kv_cache_type(),shape));
+        }
+        buffer.reset(ggml_backend_alloc_ctx_tensors(ctx.get(),weights->backend()));
+        if(!buffer)throw std::runtime_error("Talker shared KV backend allocation failed");
+        ggml_backend_buffer_clear(buffer.get(),0);
+        runtime::TransformerKVCacheOptions options;
+        options.allow_f16_storage=weights->kv_cache_type()==GGML_TYPE_F16;
+        options.allow_bf16_storage=weights->kv_cache_type()==GGML_TYPE_BF16;
+        options.lazy_import_scratch=true;
+        cache=runtime::TransformerKVCache(capacity,config.num_key_value_heads*attention_head_dim(config),
+                                          std::move(keys),std::move(values),options);
+    }
+};
