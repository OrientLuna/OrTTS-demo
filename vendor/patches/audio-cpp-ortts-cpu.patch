@@ -0,0 +1,65 @@
+#include "audiocpp.h"
+#include "file_sha256.h"
+#include <chrono>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <stdexcept>
+#include <vector>
+#include <cmath>
+
+using Clock=std::chrono::steady_clock;
+static void check(audiocpp_status s){if(s!=AUDIOCPP_OK)throw std::runtime_error(audiocpp_last_error());}
+struct Capture {Clock::time_point start;double first=-1;int chunks=0;std::vector<float> pcm;};
+static int capture(const audiocpp_event* event,void* data){
+ auto& c=*static_cast<Capture*>(data);const float* pcm=nullptr;size_t frames=0;int sr=0,ch=0;
+ if(audiocpp_result_audio(audiocpp_event_as_result(event),&pcm,&frames,&sr,&ch)!=AUDIOCPP_OK)return 1;
+ if(!frames)return 0;
+ if(!pcm||sr!=24000||ch!=1)return 1;
+ for(size_t i=0;i<frames;++i)if(!std::isfinite(pcm[i]))return 1;
+ if(c.first<0)c.first=std::chrono::duration<double,std::milli>(Clock::now()-c.start).count();
+ c.pcm.insert(c.pcm.end(),pcm,pcm+frames);c.chunks++;return 0;
+}
+int main(int argc,char** argv){
+ if(argc<3||argc>5)throw std::runtime_error("usage: b0_stream_capi ROOT OUTPUT_PREFIX [TEXT] [p5|p3]");
+ const std::filesystem::path root(argv[1]);
+ const auto bundle=root/"bridge";
+ const auto base=(root/"tokenizer-LFM2.5-Audio-1.5B-Q4_0.gguf").string();
+ const auto sha=ortts_sha256::file((bundle/"MANIFEST.json").string());
+ setenv("ORTTS_PRIVATE_BASE_DETOK_GGUF",base.c_str(),1);
+ setenv("ORTTS_PRIVATE_BRIDGE_MANIFEST_SHA256",sha.c_str(),1);
+ if(argc>4&&std::string(argv[4])=="p5")unsetenv("ORTTS_P3_PREDICTOR_SOURCE");
+ else setenv("ORTTS_P3_PREDICTOR_SOURCE",(root/"p3-source-30000").c_str(),1);
+ unsetenv("ORTTS_GROUPED_PREDICTOR_GGUF");
+ audiocpp_registry* registry=nullptr;audiocpp_model* model=nullptr;audiocpp_session* session=nullptr;
+ check(audiocpp_registry_create(nullptr,&registry));
+ audiocpp_model_config cfg{"qwen3_tts",nullptr,nullptr,nullptr};
+ check(audiocpp_model_load(registry,(root/"model.gguf").c_str(),&cfg,nullptr,&model));
+ auto* options=audiocpp_options_create();
+ auto set=[&](const char* k,const std::string& v){check(audiocpp_options_set(options,k,v.c_str()));};
+ set("qwen3_tts.fixed_speaker_f32",(root/"voices/adult_female.f32").string());
+ set("qwen3_tts.lfm_b0_bundle",bundle.string());
+ set("qwen3_tts.lfm_b0_detokenizer_gguf",(root/"tokenizer-joint160k-MIXED_Q4_0.gguf").string());
+ set("qwen3_tts.lfm_b0_vocoder_gguf",(root/"vocoder-LFM2.5-Audio-1.5B-Q4_0.gguf").string());
+ set("qwen3_tts.perf_mode","off");set("qwen3_tts.codec_pipeline","false");set("qwen3_tts.cpu_chunk_frames","0");set("qwen3_tts.stitch_decode","false");
+ audiocpp_backend_config backend{"cpu",0,4};
+ check(audiocpp_session_create(model,"tts","streaming",&backend,options,&session));
+ auto* req=audiocpp_request_create();
+ check(audiocpp_request_set_text(req,argc>3?argv[3]:"今天下午三点开会。",nullptr));
+ for(const auto& pair:std::vector<std::pair<const char*,const char*>>{{"x_vector_only_mode","true"},{"language","Chinese"},{"seed","20261023"},{"max_tokens","128"},{"subtalker_do_sample","false"},{"stream_frames_per_event","3"},{"stream_chunk_policy","fixed"}})
+  check(audiocpp_request_set_option(req,pair.first,pair.second));
+ for(int repeat=0;repeat<2;++repeat){
+  Capture c{Clock::now()};check(audiocpp_stream_set_callback(session,capture,&c));
+  check(audiocpp_stream_start(session,req));check(audiocpp_stream_set_callback(session,nullptr,nullptr));
+  audiocpp_result* result=nullptr;check(audiocpp_stream_finish(session,&result));
+  const float* pcm=nullptr;size_t frames=0;int sr=0,ch=0;check(audiocpp_result_audio(result,&pcm,&frames,&sr,&ch));
+  if(c.chunks<2||frames!=c.pcm.size())throw std::runtime_error("missing incremental callbacks or bad final length");
+  for(size_t i=0;i<frames;++i)if(pcm[i]!=c.pcm[i])throw std::runtime_error("callback PCM differs from final PCM");
+  std::ofstream out(std::string(argv[2])+"-"+std::to_string(repeat)+".f32",std::ios::binary);
+  out.write(reinterpret_cast<const char*>(pcm),frames*sizeof(float));
+  std::cout<<"repeat="<<repeat<<" first_pcm_ms="<<c.first<<" chunks="<<c.chunks<<" samples="<<frames<<" total_ms="<<std::chrono::duration<double,std::milli>(Clock::now()-c.start).count()<<std::endl;
+  audiocpp_result_free(result);
+ }
+ audiocpp_request_free(req);audiocpp_options_free(options);audiocpp_session_free(session);audiocpp_model_free(model);audiocpp_registry_free(registry);
+}
