diff --git a/tests/qwen3_tts/b0_decode_dump.cpp b/tests/qwen3_tts/b0_decode_dump.cpp
new file mode 100644
index 0000000..51b543c
--- /dev/null
+++ b/tests/qwen3_tts/b0_decode_dump.cpp
@@ -0,0 +1,101 @@
+// Decode captured codes through the joint160k B0 chain (dequant + bridge +
+// LFM2 detokenizer) natively and compare against the phone PCM. Diagnosis tool
+// for the codec QNN export; not part of model behaviour.
+#include "private_adapter.h"
+#include "file_sha256.h"
+
+#include <cstdint>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <stdexcept>
+#include <string>
+#include <vector>
+#include <algorithm>
+#include <cmath>
+
+namespace {
+void dump_f32(const std::string & path, const std::vector<float> & values) {
+    std::ofstream out(path, std::ios::binary);
+    if (!out) throw std::runtime_error("dump open failed: " + path);
+    out.write(reinterpret_cast<const char *>(values.data()),
+              static_cast<std::streamsize>(values.size() * sizeof(float)));
+}
+}  // namespace
+
+int main(int argc, char ** argv) {
+    std::string root, codes_path, out_path;
+    int stream_frames = 0;
+    for (int i = 1; i < argc; ++i) {
+        const std::string arg(argv[i]);
+        if (arg == "--root" && i + 1 < argc) root = argv[++i];
+        else if (arg == "--codes" && i + 1 < argc) codes_path = argv[++i];
+        else if (arg == "--out" && i + 1 < argc) out_path = argv[++i];
+        else if (arg == "--stream-frames" && i + 1 < argc) {
+            stream_frames = std::stoi(argv[++i]);
+            if (stream_frames < 1) throw std::runtime_error("stream frames must be positive");
+        }
+        else throw std::runtime_error("usage: --root joint160k-dir --codes codes.i32 --out pcm.f32");
+    }
+    if (root.empty() || codes_path.empty() || out_path.empty())
+        throw std::runtime_error("usage: --root joint160k-dir --codes codes.i32 --out pcm.f32");
+    const std::filesystem::path bundle = std::filesystem::path(root) / "bridge";
+    const std::string detok = (std::filesystem::path(root) / "tokenizer-joint160k-MIXED_Q4_0.gguf").string();
+    const std::string voc = (std::filesystem::path(root) / "vocoder-LFM2.5-Audio-1.5B-Q4_0.gguf").string();
+    const std::string base = (std::filesystem::path(root) / "tokenizer-LFM2.5-Audio-1.5B-Q4_0.gguf").string();
+    const std::string manifest_sha = ortts_sha256::file((bundle / "MANIFEST.json").string());
+    ortts_b0::Adapter adapter(bundle.string(), detok, voc, base, manifest_sha, 8);
+    std::ifstream input(codes_path, std::ios::binary);
+    if (!input) throw std::runtime_error("codes open failed");
+    std::vector<int32_t> codes;
+    int32_t value = 0;
+    while (input.read(reinterpret_cast<char *>(&value), sizeof(value))) codes.push_back(value);
+    if (codes.empty() || codes.size() % 16 != 0) throw std::runtime_error("codes must be frames x 16");
+    const auto result = adapter.decode(codes, static_cast<int64_t>(codes.size() / 16));
+    if (stream_frames > 0) {
+        dump_f32(out_path + ".offline.f32", result.pcm);
+        // Repeat to verify reset as well as chunk boundaries and final flush.
+        for (int repeat = 0; repeat < 2; ++repeat) {
+            adapter.start_stream();
+            std::vector<float> pcm;
+            std::vector<float> streamed_h;
+            for (size_t offset = 0; offset < codes.size();) {
+                const auto count = std::min(codes.size() - offset, size_t(stream_frames) * 16);
+                const std::vector<int32_t> chunk(codes.begin() + offset, codes.begin() + offset + count);
+                const auto part = adapter.stream(chunk, count / 16);
+                streamed_h.insert(streamed_h.end(), part.h.begin(), part.h.end());
+                pcm.insert(pcm.end(), part.pcm.begin(), part.pcm.end());
+                offset += count;
+            }
+            const auto tail = adapter.finish_stream();
+            dump_f32(out_path + ".stream.h.f32", streamed_h);
+            dump_f32(out_path + ".offline.h.f32", result.h);
+            pcm.insert(pcm.end(), tail.begin(), tail.end());
+            if (pcm.size() != result.pcm.size()) throw std::runtime_error("stream PCM length mismatch");
+            double squared_error = 0, squared_signal = 0, peak = 0;
+            for (size_t i = 0; i < pcm.size(); ++i) {
+                if (!std::isfinite(pcm[i])) throw std::runtime_error("stream nonfinite PCM");
+                const double error = double(pcm[i]) - result.pcm[i];
+                peak = std::max(peak, std::abs(error));
+                squared_error += error * error;
+                squared_signal += double(result.pcm[i]) * result.pcm[i];
+            }
+            const double relative = std::sqrt(squared_error / std::max(squared_signal, 1e-30));
+            dump_f32(out_path + ".stream.f32", pcm);
+            std::cout << "stream_frames=" << stream_frames << " reset_repeat=" << repeat
+                      << " samples=" << pcm.size() << " max_abs=" << peak << " relative_l2=" << relative << std::endl;
+            if (peak > 1e-3 || relative > 1e-3) throw std::runtime_error("stream PCM parity failed");
+        }
+    }
+    if (const char * z_path = std::getenv("ORTTS_B0_DUMP_Z")) dump_f32(z_path, result.z);
+    if (const char * h_path = std::getenv("ORTTS_B0_DUMP_H")) dump_f32(h_path, result.h);
+    if (const char * v_path = std::getenv("ORTTS_B0_DUMP_PCM")) dump_f32(v_path, result.pcm);
+    std::ofstream output(out_path, std::ios::binary);
+    if (!output) throw std::runtime_error("out open failed");
+    output.write(reinterpret_cast<const char *>(result.pcm.data()),
+                 static_cast<std::streamsize>(result.pcm.size() * sizeof(float)));
+    std::cout << "decoded " << result.pcm.size() << " samples; dequant_ms=" << result.dequant_ms
+              << " bridge_ms=" << result.bridge_ms << " decode_ms=" << result.decode_ms << "\n";
+    return 0;
+}
