+runtime::SessionOptions decoder_session_options(runtime::SessionOptions options) {
+    // RuntimeSessionBase constructs its backend before the derived constructor body.
+    options.backend.threads = cpu_codec_settings(options).decoder_threads;
+    return options;
+}
