+#pragma once
+#include <atomic>
+#include <stdexcept>
+
+// A single operation owns the execution gate; token outlives joined CPU work.
+namespace engine::core::ortts_cancel {
+inline std::atomic<const std::atomic<bool> *> active{nullptr};
+inline bool requested(void * = nullptr) noexcept {
+    const auto * token = active.load(std::memory_order_acquire);
+    return token && token->load(std::memory_order_relaxed);
+}
+inline void checkpoint() {
+    if (requested()) throw std::runtime_error("OrTTS operation cancelled");
+}
+struct Scope {
+    explicit Scope(const std::atomic<bool> * token) { active.store(token, std::memory_order_release); }
+    ~Scope() { active.store(nullptr, std::memory_order_release); }
+    Scope(const Scope &) = delete;
+    Scope & operator=(const Scope &) = delete;
+};
+}
