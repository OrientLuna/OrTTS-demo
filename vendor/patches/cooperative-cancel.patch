+#pragma once
+#include <atomic>
+#include <stdexcept>
+
+// ggml CPU invokes abort_callback exclusively on worker ith == 0 (the calling thread),
+// and all host checkpoints run on that same thread. Thread-local pointers isolate
+// concurrent handles across threads with zero cross-talk.
+namespace engine::core::ortts_cancel {
+inline thread_local const std::atomic<bool> * active = nullptr;
+inline thread_local const std::atomic<bool> * secondary = nullptr;
+inline bool requested(void * = nullptr) noexcept {
+    return (active && active->load(std::memory_order_acquire)) ||
+           (secondary && secondary->load(std::memory_order_acquire));
+}
+inline void checkpoint() {
+    if (requested()) throw std::runtime_error("OrTTS operation cancelled");
+}
+struct Scope {
+    const std::atomic<bool> * prev_active;
+    const std::atomic<bool> * prev_secondary;
+    explicit Scope(const std::atomic<bool> * token, const std::atomic<bool> * other = nullptr) noexcept
+        : prev_active(active), prev_secondary(secondary) {
+        active = token;
+        secondary = other;
+    }
+    ~Scope() {
+        active = prev_active;
+        secondary = prev_secondary;
+    }
+    Scope(const Scope &) = delete;
+    Scope & operator=(const Scope &) = delete;
+};
+}
