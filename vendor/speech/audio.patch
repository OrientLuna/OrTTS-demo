+        engine::debug::timing_log_scalar("kokoro.decoder.conditioning_ms", conditioning_ms);
+        engine::debug::timing_log_scalar("kokoro.decoder.generator_ms", generator_ms);
+        engine::debug::timing_log_scalar("kokoro.decoder.istft_ms", istft_ms);
+        return merged;
+    }
+#endif
+
+    std::vector<float> waveform = decode(predictor, ref_s);
+    constexpr size_t kFallbackChunkSamples = 6000;  // 250 ms @ 24 kHz
+    for (size_t off = 0; off < waveform.size(); off += kFallbackChunkSamples) {
+        on_audio_chunk(waveform.data() + off, std::min(kFallbackChunkSamples, waveform.size() - off));
+    }
+    return waveform;
+}
