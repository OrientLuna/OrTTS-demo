+                const int64_t step = (cursor == 0) ? kFirstEmitFrames : kSteadyDecodeFrames;
+                int64_t logical_end = std::min<int64_t>(total_frames, cursor + step);
+                if (total_frames - logical_end < 16) {
+                    logical_end = total_frames;
+                }
