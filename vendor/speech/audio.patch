+std::vector<float> KokoroIstftNetDecoderRuntime::decode_streaming(
+    const PredictorOutputs & predictor,
+    const std::vector<float> & ref_s,
+    const std::function<void(const float * samples, size_t count)> & on_audio_chunk) {
+    if (!on_audio_chunk) {
+        return decode(predictor, ref_s);
+    }
+    if (static_cast<int64_t>(ref_s.size()) != 256) {
+        throw std::runtime_error("Kokoro decoder requires ref_s with 256 elements");
+    }
+
+#ifdef ENGINE_HAVE_NEON
+    if (impl_->neon_generator) {
+        const std::vector<float> style_decoder(ref_s.begin(), ref_s.begin() + 128);
+        double conditioning_ms = 0.0;
+        double generator_ms = 0.0;
+        double istft_ms = 0.0;
+
+        const int64_t total_frames = predictor.decoder_x_cols;
+        if (total_frames <= 0) {
+            throw std::runtime_error("Kokoro decoder requires positive decoder frames");
+        }
+        if (static_cast<int64_t>(predictor.f0_curve.size()) != total_frames) {
+            throw std::runtime_error("Kokoro decoder f0 curve frame count mismatch");
+        }
+        const std::vector<float> full_x = read_decoder_x(predictor);
+        if (static_cast<int64_t>(full_x.size()) != predictor.decoder_x_rows * total_frames) {
+            throw std::runtime_error("Kokoro streaming decoder latent size mismatch");
+        }
+        const auto & gen_weights = impl_->weights->decoder.generator;
+        const int64_t x_rows = predictor.decoder_x_rows;
+        const int64_t hop = impl_->inverse_stft_config.hop_length;
+        const int64_t bins = impl_->inverse_stft_config.n_fft / 2 + 1;
+        const int64_t feature_rows = bins * 2;
+        const int64_t harmonic_dims = gen_weights.harmonic_num + 1;
+        if (gen_weights.source_linear.weight.empty() ||
+            static_cast<int64_t>(gen_weights.source_linear.weight.size()) < harmonic_dims ||
+            (gen_weights.source_linear.use_bias && gen_weights.source_linear.bias.empty())) {
+            throw std::runtime_error("kokoro decoder source affine weights are missing");
+        }
+        int64_t samples_per_frame = hop;
+        for (const auto & up : gen_weights.ups) {
+            samples_per_frame *= up.stride;
+        }
+        const int64_t cols_per_frame = samples_per_frame / hop;
+        const auto & stft_window = audio::get_cached_stft_window(impl_->inverse_stft_config);
+
+        std::vector<float> coarse_phase;
+        conditioning_ms += measure_ms([&]() {
+            coarse_phase.resize(static_cast<size_t>(harmonic_dims * total_frames));
+            for (int64_t h = 0; h < harmonic_dims; ++h) {
+                const float harmonic = static_cast<float>(h + 1);
+                float acc = 0.0f;
+                for (int64_t t = 0; t < total_frames; ++t) {
+                    acc += std::fmod(
+                        (predictor.f0_curve[static_cast<size_t>(t)] * harmonic) /
+                            static_cast<float>(gen_weights.sampling_rate),
+                        1.0f);
+                    coarse_phase[static_cast<size_t>(h * total_frames + t)] =
+                        acc * 2.0f * kPi * static_cast<float>(samples_per_frame);
+                }
+            }
+        });
+
+        auto splitmix64 = [](uint64_t x) noexcept -> uint64_t {
+            x += 0x9e3779b97f4a7c15ULL;
+            x = (x ^ (x >> 30)) * 0xbf58476d1ce4e5b9ULL;
+            x = (x ^ (x >> 27)) * 0x94d049bb133111ebULL;
+            return x ^ (x >> 31);
+        };
+        auto u01 = [](uint64_t r) noexcept -> float {
+            return (static_cast<float>(static_cast<uint32_t>(r >> 32)) + 0.5f) / 4294967296.0f;
+        };
+        const float source_bias = gen_weights.source_linear.use_bias ? gen_weights.source_linear.bias[0] : 0.0f;
+        const int64_t noise_pairs = (harmonic_dims + 1) / 2;
+        const uint64_t rng_seed = impl_->rng_seed;
+
+        auto decode_window = [&](int64_t lo, int64_t count) -> std::vector<float> {
+            std::vector<float> win_x(static_cast<size_t>(x_rows * count));
+            for (int64_t row = 0; row < x_rows; ++row) {
+                std::copy_n(
+                    full_x.data() + static_cast<size_t>(row * total_frames + lo),
+                    static_cast<size_t>(count),
+                    win_x.data() + static_cast<size_t>(row * count));
+            }
+            const int64_t win_samples = count * samples_per_frame;
+            const int64_t win_cols = cols_per_frame * count + 1;
+            std::vector<float> win_har(static_cast<size_t>(feature_rows * win_cols));
+            conditioning_ms += measure_ms([&]() {
+                std::vector<float> win_source(static_cast<size_t>(win_samples));
+                const int64_t sample_offset = lo * samples_per_frame;
+                for (int64_t s = 0; s < win_samples; ++s) {
+                    const int64_t t_global = sample_offset + s;
+                    const int64_t frame = std::min<int64_t>(t_global / samples_per_frame, total_frames - 1);
+                    const float uv_t =
+                        predictor.f0_curve[static_cast<size_t>(frame)] > gen_weights.voiced_threshold ? 1.0f : 0.0f;
+                    const float noise_amp =
+                        uv_t * gen_weights.noise_std + (1.0f - uv_t) * gen_weights.sine_amp / 3.0f;
+                    const float src =
+                        (static_cast<float>(t_global) + 0.5f) / static_cast<float>(samples_per_frame) - 0.5f;
+                    int64_t left = 0;
+                    int64_t right = 0;
+                    float frac = 0.0f;
+                    if (src >= static_cast<float>(total_frames - 1)) {
+                        left = total_frames - 1;
+                        right = total_frames - 1;
+                    } else if (src > 0.0f) {
+                        left = static_cast<int64_t>(std::floor(src));
+                        right = left + 1;
+                        frac = src - static_cast<float>(left);
+                    }
+                    const float w_left = 1.0f - frac;
+                    float merged_src = source_bias;
+                    float n0 = 0.0f;
+                    float n1 = 0.0f;
+                    for (int64_t h = 0; h < harmonic_dims; ++h) {
+                        if ((h & 1) == 0) {
+                            const uint64_t key =
+                                static_cast<uint64_t>(t_global) * static_cast<uint64_t>(noise_pairs) +
+                                static_cast<uint64_t>(h >> 1);
+                            const uint64_t r1 = splitmix64(rng_seed ^ (key * 0x517cc1b727220a95ULL + 1ULL));
+                            const uint64_t r2 = splitmix64(r1);
+                            const float radius = std::sqrt(-2.0f * std::log(std::max(u01(r1), 1.0e-12f)));
+                            const float theta = 2.0f * kPi * u01(r2);
+                            n0 = radius * std::cos(theta);
+                            n1 = radius * std::sin(theta);
+                        }
+                        const float noise_h = ((h & 1) == 0) ? n0 : n1;
+                        const size_t base = static_cast<size_t>(h * total_frames);
+                        const float interp_phase =
+                            coarse_phase[base + static_cast<size_t>(left)] * w_left +
+                            coarse_phase[base + static_cast<size_t>(right)] * frac;
+                        const float base_sine = std::sin(interp_phase) * gen_weights.sine_amp;
+                        const float noisy_sine = base_sine * uv_t + noise_amp * noise_h;
+                        merged_src += gen_weights.source_linear.weight[static_cast<size_t>(h)] * noisy_sine;
+                    }
+                    win_source[static_cast<size_t>(s)] = std::tanh(merged_src);
+                }
+                const audio::AudioTensor stft_out = audio::STFT().compute_complex(
+                    win_source,
+                    stft_window,
+                    1,
+                    win_samples,
+                    impl_->inverse_stft_config,
+                    static_cast<size_t>(impl_->n_threads));
+                if (stft_out.shape.size() < 3 ||
+                    stft_out.shape[1] != bins ||
+                    stft_out.shape[2] != win_cols) {
+                    throw std::runtime_error("Kokoro streaming per-window STFT shape mismatch");
+                }
+                for (int64_t bin = 0; bin < bins; ++bin) {
+                    for (int64_t col = 0; col < win_cols; ++col) {
+                        const size_t base = static_cast<size_t>(((bin * win_cols) + col) * 2);
+                        const float re = stft_out.values[base];
+                        const float im = stft_out.values[base + 1];
+                        win_har[static_cast<size_t>(bin * win_cols + col)] = std::sqrt(re * re + im * im);
+                        win_har[static_cast<size_t>((bin + bins) * win_cols + col)] = std::atan2(im, re);
+                    }
+                }
+            });
+            std::vector<float> gen_out;
+            generator_ms += measure_ms([&]() {
+                gen_out = impl_->neon_generator->run(
+                    win_x, int(count), win_har, int(win_cols), style_decoder, impl_->n_threads).values;
+            });
+            const int64_t gen_cols = static_cast<int64_t>(gen_out.size()) / bins / 2;
+            if (win_cols <= 0 || win_cols > gen_cols) {
+                throw std::runtime_error("Kokoro streaming decoder spectrogram columns mismatch");
+            }
+            std::vector<float> pcm;
+            istft_ms += measure_ms([&]() {
+                const int64_t target_samples = count * samples_per_frame;
+                pcm = spectrogram_to_waveform(
+                    gen_out,
+                    gen_cols,
+                    bins,
+                    win_cols,
+                    target_samples,
+                    impl_->inverse_stft_config);
+                if (static_cast<int64_t>(pcm.size()) < target_samples) {
+                    throw std::runtime_error("Kokoro streaming ISTFT produced fewer samples than expected");
+                }
+                pcm.resize(static_cast<size_t>(target_samples));
+            });
+            return pcm;
+        };
+
+        constexpr int64_t kFirstEmitFrames = 16;     // 200 ms window (175 ms net first emit)
+        constexpr int64_t kSteadyDecodeFrames = 48;  // 600 ms decode pass for low RTF
+        constexpr int64_t kSteadyEmitFrames = 24;    // 300 ms callback slice
+        constexpr int64_t kContextFrames = 11;       // >= 10.75 conv receptive field radius
+        constexpr int64_t kOverlapFrames = 2;        // 25 ms raised-cosine crossfade
+        const int64_t valid_waveform_samples = total_frames * samples_per_frame;
+        const size_t slice_len = static_cast<size_t>(kSteadyEmitFrames * samples_per_frame);
+        const size_t min_tail_samples = static_cast<size_t>(8 * samples_per_frame);
+
+        std::vector<float> merged;
+        merged.reserve(static_cast<size_t>(total_frames * samples_per_frame));
+
+        if (total_frames <= kFirstEmitFrames + kContextFrames) {
+            merged = decode_window(0, total_frames);
+            if (static_cast<int64_t>(merged.size()) > valid_waveform_samples) {
+                merged.resize(static_cast<size_t>(valid_waveform_samples));
+            }
+            for (size_t off = 0; off < merged.size(); off += slice_len) {
+                on_audio_chunk(merged.data() + off, std::min(slice_len, merged.size() - off));
+            }
+        } else {
