+                merged.insert(merged.end(), chunk_out.begin(), chunk_out.end());
+                if (!chunk_out.empty()) {
+                    if (is_first) {
+                        on_audio_chunk(chunk_out.data(), chunk_out.size());
+                    } else {
+                        for (size_t off = 0; off < chunk_out.size();) {
+                            size_t emit_len = std::min(slice_len, chunk_out.size() - off);
+                            const size_t remaining = chunk_out.size() - (off + emit_len);
+                            if (remaining > 0 && remaining < min_tail_samples) {
+                                emit_len += remaining;
+                            }
+                            on_audio_chunk(chunk_out.data() + off, emit_len);
+                            off += emit_len;
+                        }
+                    }
+                }
+                cursor = logical_end;
+            }
+            if (static_cast<int64_t>(merged.size()) > valid_waveform_samples) {
+                merged.resize(static_cast<size_t>(valid_waveform_samples));
+            }
+        }
