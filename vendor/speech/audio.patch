+// OrTTS incremental Moonshine session. Shares this translation unit's ggml
+// implementation; no second backend. Encoder uses bounded overlap, decoder
+// hypotheses are recomputed because new cross-memory invalidates self-KV.
+struct MoonshineIncrementalConfig {
+    size_t update_samples = 6400;
+    size_t min_partial_samples = 16000;
+    size_t max_segment_samples = 240000;
+    size_t endpoint_silence_samples = 12800; // 0 disables energy endpoint
+    float energy_threshold = 0.003F;
+};
+struct MoonshineIncrementalEvent {
+    std::string text;
+    uint64_t segment = 0, start = 0, end = 0, revision = 0;
+    int endpoint = 0; // 0 partial, 1 explicit flush, 2 energy silence, 3 limit
+};
+struct MoonshineIncrementalStats {
+    uint64_t received = 0, processed = 0, encoded = 0, updates = 0;
+    size_t buffered = 0, cached_frames = 0, segment_samples = 0;
+    size_t peak_buffered = 0, peak_cached_frames = 0;
+    double encoder_ms = 0, decoder_ms = 0;
+};
+class MoonshineIncremental {
+public:
+    using Sink = std::function<bool(const MoonshineIncrementalEvent &)>; // true cancels
+    using Cancel = std::function<bool()>;
+    MoonshineIncremental(const std::string & model, int threads, MoonshineIncrementalConfig);
+    ~MoonshineIncremental();
+    MoonshineIncremental(const MoonshineIncremental &) = delete;
+    MoonshineIncremental & operator=(const MoonshineIncremental &) = delete;
+    bool accept(const float *, size_t, const Sink &, const Cancel &);
+    bool finish(const Sink &, const Cancel &);
+    void reset();
+    MoonshineIncrementalStats stats() const;
+private:
+    struct Impl;
+    std::unique_ptr<Impl> impl_;
+};
+
 }  // namespace engine::models::moonshine_asr
